diff -ruN '--exclude=.git' '--exclude=node_modules' '--exclude=.next' '--exclude=dist' '--exclude=*.tsbuildinfo' '--exclude=next-env.d.ts' '--exclude=package-lock.json' a/frontend/components/dashboard/WeeklyChart.tsx b/frontend/components/dashboard/WeeklyChart.tsx
--- a/frontend/components/dashboard/WeeklyChart.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/components/dashboard/WeeklyChart.tsx	2026-10-30 07:51:40.439377105 +0000
@@ -0,0 +1,83 @@
+'use client';
+import { useState } from 'react';
+
+type Day = { date: string; reviews: number };
+const WEEKDAY = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
+const W = 700, H = 220;
+
+/** Trục dọc chia 4 khoảng đều, bước là số "tròn" để nhãn dễ đọc */
+function scale(v: number) {
+  const step = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000].find((s) => s * 4 >= v) ?? Math.ceil(v / 4);
+  return { step, max: step * 4 };
+}
+/** Đường cong mượt: mỗi đoạn là Bezier có tiếp tuyến ngang nên không bao giờ vọt qua điểm dữ liệu */
+const smooth = (p: { x: number; y: number }[]) => p.reduce((d, b, i) => (i === 0 ? `M${b.x},${b.y}` : `${d} C${(p[i - 1].x + b.x) / 2},${p[i - 1].y} ${(p[i - 1].x + b.x) / 2},${b.y} ${b.x},${b.y}`), '');
+
+/** Biểu đồ vùng 7 ngày gần nhất (số lượt ôn mỗi ngày) kèm đường mục tiêu. Dữ liệu thật từ /study/activity. */
+export default function WeeklyChart({ days, goal }: { days: Day[]; goal: number }) {
+  const [hover, setHover] = useState<number | null>(null);
+  const n = days.length;
+  const top = Math.max(0, ...days.map((d) => d.reviews));
+  const { step, max } = scale(Math.max(goal, top, 1));
+  const best = top > 0 ? days.findIndex((d) => d.reviews === top) : -1;
+  const shown = hover ?? (best >= 0 ? best : null);
+  const pts = days.map((d, i) => ({ x: ((i + 0.5) / n) * W, y: H - (d.reviews / max) * H }));
+  const line = n ? smooth(pts) : '';
+  const area = n ? `${line} L${pts[n - 1].x},${H} L${pts[0].x},${H} Z` : '';
+  const dayName = (d: string) => WEEKDAY[new Date(d + 'T00:00:00').getDay()];
+  const dateText = (d: string) => { const t = new Date(d + 'T00:00:00'); return `${t.getDate()}/${t.getMonth() + 1}`; };
+
+  return (
+    <div>
+      <div className="grid grid-cols-[minmax(0,1fr)_auto] gap-x-3">
+        <div className="relative h-[190px] sm:h-[230px]" onMouseLeave={() => setHover(null)}>
+          <svg role="img" aria-label={`Số lượt ôn 7 ngày gần nhất: ${days.map((d) => `${dayName(d.date)} ${d.reviews}`).join(', ')}. Mục tiêu mỗi ngày ${goal}.`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" className="absolute inset-0 h-full w-full overflow-visible">
+            <defs>
+              <linearGradient id="wk-fill" x1="0" y1="0" x2="0" y2="1">
+                <stop offset="0" stopColor="rgb(184 162 248)" stopOpacity=".55" />
+                <stop offset="1" stopColor="rgb(184 162 248)" stopOpacity="0" />
+              </linearGradient>
+            </defs>
+            {[0, 1, 2, 3, 4].map((k) => <line key={k} x1="0" x2={W} y1={(H * k) / 4} y2={(H * k) / 4} stroke="rgb(229 226 236)" strokeWidth="1" vectorEffect="non-scaling-stroke" />)}
+            {goal > 0 && <line x1="0" x2={W} y1={H - (goal / max) * H} y2={H - (goal / max) * H} stroke="rgb(91 63 209)" strokeOpacity=".5" strokeWidth="1.2" strokeDasharray="5 5" vectorEffect="non-scaling-stroke" />}
+            {n > 0 && <path d={area} fill="url(#wk-fill)" />}
+            {n > 0 && <path d={line} fill="none" stroke="rgb(91 63 209)" strokeWidth="2.5" strokeLinecap="round" vectorEffect="non-scaling-stroke" />}
+          </svg>
+
+          {shown !== null && (
+            <>
+              <span aria-hidden className="pointer-events-none absolute bottom-0 w-0 border-l border-dashed border-brand-ink/60" style={{ left: `${((shown + 0.5) / n) * 100}%`, top: `${(1 - days[shown].reviews / max) * 100}%` }} />
+              <span aria-hidden className="pointer-events-none absolute h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-brand-ink shadow" style={{ left: `${((shown + 0.5) / n) * 100}%`, top: `${(1 - days[shown].reviews / max) * 100}%` }} />
+              <div
+                role="status"
+                className={`pointer-events-none absolute z-10 w-max max-w-[11rem] rounded-xl bg-ink px-3 py-2 text-white ${shown === 0 ? '' : shown === n - 1 ? '-translate-x-full' : '-translate-x-1/2'}`}
+                style={{ left: `${((shown + 0.5) / n) * 100}%`, top: `calc(${(1 - days[shown].reviews / max) * 100}% - 14px)`, transform: `${shown === 0 ? '' : shown === n - 1 ? 'translateX(-100%)' : 'translateX(-50%)'} translateY(-100%)` }}
+              >
+                <span className="block text-sm font-bold leading-tight tabular-nums">{days[shown].reviews} lượt ôn</span>
+                <span className="block text-[11px] leading-tight text-white/75">{shown === best ? 'Ngày học nhiều nhất' : `${dayName(days[shown].date)}, ${dateText(days[shown].date)}`}</span>
+              </div>
+            </>
+          )}
+
+          <div className="absolute inset-0 grid" style={{ gridTemplateColumns: `repeat(${n}, minmax(0, 1fr))` }}>
+            {days.map((d, i) => (
+              <button key={d.date} type="button" aria-label={`${dayName(d.date)}, ${dateText(d.date)}: ${d.reviews} lượt ôn`} onMouseEnter={() => setHover(i)} onFocus={() => setHover(i)} onBlur={() => setHover(null)} onClick={() => setHover(i)} className="h-full cursor-default rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-brand-ink" />
+            ))}
+          </div>
+
+          {top === 0 && n > 0 && <p className="pointer-events-none absolute inset-x-0 top-1/3 text-center text-sm text-stone-600">Chưa có lượt ôn nào trong 7 ngày qua. Học một lượt để bắt đầu.</p>}
+        </div>
+
+        <ol aria-hidden className="relative h-[190px] w-7 text-right text-xs tabular-nums text-stone-500 sm:h-[230px]">
+          {[4, 3, 2, 1, 0].map((k) => <li key={k} className="absolute right-0 -translate-y-1/2" style={{ top: `${((4 - k) / 4) * 100}%` }}>{k * step}</li>)}
+        </ol>
+      </div>
+
+      <ol className="mt-3 grid grid-cols-[minmax(0,1fr)_1.75rem] gap-x-3" aria-hidden>
+        <li className="grid list-none" style={{ gridTemplateColumns: `repeat(${n}, minmax(0, 1fr))` }}>
+          {days.map((d, i) => <span key={d.date} className={`text-center text-xs ${i === shown ? 'font-semibold text-ink' : 'text-stone-500'}`}>{dayName(d.date)}</span>)}
+        </li>
+      </ol>
+    </div>
+  );
+}
diff -ruN '--exclude=.git' '--exclude=node_modules' '--exclude=.next' '--exclude=dist' '--exclude=*.tsbuildinfo' '--exclude=next-env.d.ts' '--exclude=package-lock.json' a/frontend/components/nav/Docks.tsx b/frontend/components/nav/Docks.tsx
--- a/frontend/components/nav/Docks.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/components/nav/Docks.tsx	2026-10-30 07:50:35.119378599 +0000
@@ -0,0 +1,59 @@
+'use client';
+import { Suspense, useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'next/navigation';
+import { SETTINGS, type NavItem, type Section } from './config';
+import { IconLink } from './IconLink';
+
+type DockProps = { item: NavItem; pathname: string; tip: 'right' | false; onHint?: (l: string) => void };
+
+function ModeAware({ item, pathname, tip, onHint }: DockProps) {
+  const mode = useSearchParams().get('mode');
+  return <IconLink href={item.href} label={item.label} icon={item.icon} active={item.match(pathname, mode)} tip={tip} onHint={onHint} />;
+}
+
+/** Mục có phụ thuộc ?mode= được bọc Suspense để trang vẫn dựng sẵn được khi build */
+function DockItem(p: DockProps) {
+  if (!p.item.usesMode) return <IconLink href={p.item.href} label={p.item.label} icon={p.item.icon} active={p.item.match(p.pathname, null)} tip={p.tip} onHint={p.onHint} />;
+  return (
+    <Suspense fallback={<IconLink href={p.item.href} label={p.item.label} icon={p.item.icon} active={false} tip={p.tip} onHint={p.onHint} />}>
+      <ModeAware {...p} />
+    </Suspense>
+  );
+}
+
+/** Thanh bên dọc (máy tính): mục của khu vực đang chọn + Cài đặt, chỉ icon */
+export function SideDock({ section, pathname }: { section: Section; pathname: string }) {
+  return (
+    <nav aria-label={`Mục của ${section.label}`} className="flex w-14 flex-col items-center gap-1 rounded-full bg-white px-1.5 py-3 shadow-card">
+      {section.items.map((i) => <DockItem key={i.href} item={i} pathname={pathname} tip="right" />)}
+      <span aria-hidden className="my-1 h-px w-6 bg-line" />
+      <DockItem item={SETTINGS} pathname={pathname} tip="right" />
+    </nav>
+  );
+}
+
+/**
+ * Thanh dưới đáy (điện thoại): cùng các mục, cuộn ngang được. Không có hover trên màn hình cảm ứng nên tên mục
+ * hiện thành chú thích ngắn phía trên thanh khi chạm vào (hoặc khi focus bằng bàn phím).
+ */
+export function MobileDock({ section, pathname }: { section: Section; pathname: string }) {
+  const [hint, setHint] = useState<string | null>(null);
+  const timer = useRef<ReturnType<typeof setTimeout>>();
+  const strip = useRef<HTMLDivElement>(null);
+  const show = (l: string) => { setHint(l); clearTimeout(timer.current); timer.current = setTimeout(() => setHint(null), 1600); };
+  useEffect(() => () => clearTimeout(timer.current), []);
+  useEffect(() => {
+    const el = strip.current?.querySelector<HTMLElement>('[aria-current="page"]');
+    if (el && strip.current) strip.current.scrollTo({ left: el.offsetLeft - strip.current.clientWidth / 2 + el.clientWidth / 2, behavior: 'auto' });
+  }, [pathname, section.id]);
+  return (
+    <div className="fixed inset-x-0 bottom-0 z-40 lg:hidden">
+      {hint && <div role="status" className="pointer-events-none absolute -top-10 left-1/2 -translate-x-1/2 animate-fade-in whitespace-nowrap rounded-lg bg-ink px-3 py-1.5 text-xs font-medium text-white">{hint}</div>}
+      <nav aria-label={`Mục của ${section.label}`} className="border-t border-line bg-white pb-[var(--safe-bottom)]">
+        <div ref={strip} className="mx-auto flex max-w-xl items-center gap-1 overflow-x-auto px-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" style={{ height: 'var(--nav-h)' }}>
+          {[...section.items, SETTINGS].map((i) => <DockItem key={i.href} item={i} pathname={pathname} tip={false} onHint={show} />)}
+        </div>
+      </nav>
+    </div>
+  );
+}
diff -ruN '--exclude=.git' '--exclude=node_modules' '--exclude=.next' '--exclude=dist' '--exclude=*.tsbuildinfo' '--exclude=next-env.d.ts' '--exclude=package-lock.json' a/frontend/components/nav/IconLink.tsx b/frontend/components/nav/IconLink.tsx
--- a/frontend/components/nav/IconLink.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/frontend/components/nav/IconLink.tsx	2026-10-30 04:29:19.383288095 +0000
@@ -0,0 +1,34 @@
+'use client';
+import Link from 'next/link';
+import type { LucideIcon } from 'lucide-react';
+import Tip from './Tip';
+
+const SIZE = { md: 'h-11 w-11', pill: 'h-11 w-10 sm:w-14' } as const;
+
+/** Lớp dùng chung cho nút icon tròn: hover (nền nhạt + icon phóng 1,08), focus (viền), đang chọn (nền đen, icon trắng). */
+export const iconBtn = (active: boolean, size: keyof typeof SIZE = 'md') =>
+  `group/ico relative inline-flex shrink-0 items-center justify-center rounded-full outline-none transition-colors duration-200 focus-visible:ring-2 focus-visible:ring-brand-ink focus-visible:ring-offset-2 focus-visible:ring-offset-paper ${SIZE[size]} ${
+    active ? 'bg-ink text-white' : 'text-stone-500 hover:bg-brand-soft hover:text-ink focus-visible:bg-brand-soft focus-visible:text-ink'
+  }`;
+export const iconGlyph = 'h-5 w-5 transition-transform duration-200 ease-out group-hover/ico:scale-[1.08] group-focus-visible/ico:scale-[1.08] motion-reduce:transition-none';
+
+type Common = { label: string; icon: LucideIcon; active?: boolean; size?: keyof typeof SIZE; tip?: 'bottom' | 'top' | 'right' | false; tipAlign?: 'center' | 'end'; onHint?: (label: string) => void };
+
+export function IconLink({ href, label, icon: Icon, active = false, size = 'md', tip = 'bottom', tipAlign = 'center', onHint }: Common & { href: string }) {
+  const link = (
+    <Link href={href} aria-label={label} aria-current={active ? 'page' : undefined} onFocus={() => onHint?.(label)} onPointerDown={(e) => { if (e.pointerType !== 'mouse') onHint?.(label); }} className={iconBtn(active, size)}>
+      <Icon strokeWidth={1.8} className={iconGlyph} aria-hidden />
+    </Link>
+  );
+  return tip ? <Tip label={label} side={tip} align={tipAlign}>{link}</Tip> : link;
+}
+
+export function IconButton({ label, icon: Icon, active = false, size = 'md', tip = 'bottom', tipAlign = 'center', onClick, expanded, children }: Common & { onClick: () => void; expanded?: boolean; children?: React.ReactNode }) {
+  const btn = (
+    <button type="button" onClick={onClick} aria-label={label} aria-expanded={expanded} aria-haspopup={expanded === undefined ? undefined : 'true'} className={iconBtn(active, size)}>
+      <Icon strokeWidth={1.8} className={iconGlyph} aria-hidden />
+      {children}
+    </button>
+  );
+  return tip && !expanded ? <Tip label={label} side={tip} align={tipAlign}>{btn}</Tip> : btn;
+}
diff -ruN '--exclude=.git' '--exclude=node_modules' '--exclude=.next' '--exclude=dist' '--exclude=*.tsbuildinfo' '--exclude=next-env.d.ts' '--exclude=package-lock.json' a/frontend/components/nav/Tip.tsx b/frontend/components/nav/Tip.tsx
