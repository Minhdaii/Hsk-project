{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2021", "declaration": false, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, "sourceMap": false, "outDir": "./dist", "baseUrl": "./",
    "incremental": true, "skipLibCheck": true, "strict": true, "strictPropertyInitialization": false
  },
  "include": ["src/**/*", "prisma/seed.ts"],
  "exclude": ["node_modules", "dist"]
}
