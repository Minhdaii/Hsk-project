+  webDir: 'mobile/www',                     // chỉ chứa trang chờ/ngoại tuyến; giao diện thật tải từ CAP_SERVER_URL
+  server: server
+    ? { url: server, androidScheme: 'https', cleartext: server.startsWith('http://'), errorPath: 'offline.html' }
+    : { androidScheme: 'https' },
+  android: { allowMixedContent: false },
+  plugins: {
+    // tự ẩn sau 1,2 giây để màn hình chờ không bao giờ kẹt (kể cả khi mở ở trang ngoại tuyến); NativeBridge ẩn sớm hơn khi giao diện sẵn sàng
