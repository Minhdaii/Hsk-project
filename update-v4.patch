+import type { MetadataRoute } from 'next';
+
+/** Manifest ứng dụng web (PWA): cho phép "Thêm vào màn hình chính" và là nền để đóng gói APK */
+export default function manifest(): MetadataRoute.Manifest {
+  return {
+    name: 'Học tiếng Trung HSK 1-3',
+    short_name: 'HSK',
+    description: 'Học từ vựng, ngữ pháp HSK 1-3 với flashcard lặp lại ngắt quãng, bài tập, nghe phát âm và tập viết chữ Hán.',
+    lang: 'vi',
+    start_url: '/dashboard',
+    scope: '/',
+    display: 'standalone',
+    orientation: 'portrait',
+    background_color: '#F5F4F8',
+    theme_color: '#F5F4F8',
+    icons: [
+      { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png', purpose: 'any' },
+      { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png', purpose: 'any' },
+      { src: '/icons/maskable-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' },
+    ],
+  };
+}
