diff --git a/frontend/components/native/NativeBridge.tsx b/frontend/components/native/NativeBridge.tsx
new file mode 100644
index 0000000..c21bc80
--- /dev/null
+++ b/frontend/components/native/NativeBridge.tsx
@@ -0,0 +1,34 @@
+'use client';
+import { useEffect } from 'react';
+
+/**
+ * Cầu nối cho bản ứng dụng Android (Capacitor). Trên trình duyệt thường thì không làm gì.
+ * Trong ứng dụng: đánh dấu <html class="is-native"> (CSS riêng), chỉnh thanh trạng thái, ẩn màn hình chờ khi giao diện sẵn sàng,
+ * và xử lý nút Back của điện thoại: quay lại trang trước, đang ở trang gốc thì thoát ứng dụng.
+ */
+const ROOTS = ['/', '/dashboard'];
+
+export default function NativeBridge() {
+  useEffect(() => {
+    let remove: (() => void) | undefined;
+    let cancelled = false;
+    (async () => {
+      const { Capacitor } = await import('@capacitor/core');
+      if (!Capacitor.isNativePlatform() || cancelled) return;
+      document.documentElement.classList.add('is-native');
+      const [{ App }, { StatusBar, Style }, { SplashScreen }] = await Promise.all([
+        import('@capacitor/app'), import('@capacitor/status-bar'), import('@capacitor/splash-screen'),
+      ]);
+      StatusBar.setStyle({ style: Style.Light }).catch(() => {});            // chữ tối trên nền sáng
+      StatusBar.setBackgroundColor({ color: '#F5F4F8' }).catch(() => {});
+      SplashScreen.hide().catch(() => {});
+      const handle = await App.addListener('backButton', ({ canGoBack }) => {
+        if (canGoBack && !ROOTS.includes(window.location.pathname)) window.history.back();
+        else App.exitApp();
+      });
+      remove = () => { handle.remove(); };
+    })();
+    return () => { cancelled = true; remove?.(); };
+  }, []);
+  return null;
+}
