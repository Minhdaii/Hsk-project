+const server = process.env.CAP_SERVER_URL;
+
+const config: CapacitorConfig = {
+  appId: 'vn.hsk.hoctiengtrung',           // đổi thành tên gói của bạn trước khi phát hành, ví dụ com.tenban.hsk
