+async function recognizeAi(strokes: Stroke[]): Promise<AiReply | null> {
+  if (Date.now() < aiPausedUntil) return null;
+  const key = strokesKey(strokes);
+  const hit = aiCache.get(key);
+  if (hit) return hit;
+  const image = renderStrokes(strokes);
