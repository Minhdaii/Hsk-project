+import { ApiError, api } from '@/lib/api';
 import { normalizeForEngine, Stroke } from './segment';
 
 /**
- * Lớp bọc thư viện nhận diện chữ Hán viết tay HanziLookupJS (chạy hoàn toàn trên trình duyệt, nét viết KHÔNG gửi đi đâu).
